DEFAULT_OUTPUT_ROOT=./outputs
SHIN_VIDEO_TTS_PROVIDER=minimax

MINIMAX_API_KEY=你的_minimax_api_key
MINIMAX_TTS_ENDPOINT=https://api.minimax.chat/v1/t2a_v2
MINIMAX_TTS_MODEL=speech-2.8-hd
MINIMAX_VOICE_ID="Chinese (Mandarin)_Reliable_Executive"
# 如果你的 MiniMax 控制台要求 GroupId，再打开这一行
# MINIMAX_GROUP_ID=你的_group_id

# 使用火山引擎时，把 SHIN_VIDEO_TTS_PROVIDER 改成 volcengine。
# 默认接口、资源 ID 和音色已经内置，通常只需要填写 API Key。
VOLCENGINE_TTS_API_KEY=你的_火山引擎_api_key
# VOLCENGINE_TTS_ENDPOINT=https://openspeech.bytedance.com/api/v3/tts/unidirectional/sse
# VOLCENGINE_TTS_RESOURCE_ID=seed-tts-2.0
# VOLCENGINE_TTS_VOICE_ID=zh_female_xiaohe_uranus_bigtts

# 使用其他支持“音频 + 原生时间戳”的 TTS 时，把服务商改成 custom。
# SHIN_VIDEO_TTS_PROVIDER=custom
# CUSTOM_TTS_ENDPOINT=https://你的接口地址
# CUSTOM_TTS_API_KEY=你的_api_key
# CUSTOM_TTS_MODEL=你的模型名称
# CUSTOM_TTS_VOICE_ID=你的_voice_id
